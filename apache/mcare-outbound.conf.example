# Load only from a private Apache server/vhost configuration, never from .htaccess.
# Keep the secret out of the repository after replacing this template.
SetEnv MCARE_AMI_HOST 127.0.0.1
SetEnv MCARE_AMI_PORT 5038
SetEnv MCARE_AMI_USERNAME mcare_outbound
SetEnv MCARE_AMI_SECRET REPLACE_WITH_THE_SAME_LONG_RANDOM_SECRET_AS_MANAGER_CONF
SetEnv MCARE_OUTBOUND_PJSIP_ENDPOINT mcare-mtn
SetEnv MCARE_OUTBOUND_CALLER_ID REPLACE_WITH_PROVIDER_AUTHORIZED_CALLER_ID
SetEnv MCARE_OUTBOUND_NUMBER_FORMAT REPLACE_WITH_PROVIDER_FORMAT
SetEnv MCARE_OUTBOUND_NUMBER_PREFIX
SetEnv MCARE_OUTBOUND_RING_TIMEOUT_MS 45000
SetEnv MCARE_OUTBOUND_MAX_CONCURRENT 2
SetEnv MCARE_CALLING_HOUR_START 8
SetEnv MCARE_CALLING_HOUR_END 18
SetEnv MCARE_REMINDER_CALLS_ENABLED 0
