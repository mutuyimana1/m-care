[Unit]
Description=M-CARE outbound call queue worker
After=network.target asterisk.service mariadb.service mcare-ami-events.service
Requires=asterisk.service

[Service]
Type=oneshot
User=asterisk
Group=asterisk
WorkingDirectory=/opt/lampp/htdocs/care
EnvironmentFile=/etc/mcare/outbound.env
ExecStart=/usr/bin/php /opt/lampp/htdocs/care/asterisk/outbound_scheduler.php --once
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/lampp/htdocs/care
