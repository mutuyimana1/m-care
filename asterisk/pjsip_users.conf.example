; Ten independently authenticated local softphone accounts for concurrency tests.
; Use each credential on a softphone running on this same machine only.
[auth_6001]
type=auth
auth_type=userpass
username=6001
password=CHANGE-THIS-LOCAL-6001!

[aor_6001]
type=aor
max_contacts=1
remove_existing=yes

[6001]
type=endpoint
transport=transport-udp-local
context=mcare-ivr-test
disallow=all
allow=ulaw
allow=alaw
auth=auth_6001
aors=aor_6001
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes

