; Copy this to a private development config directory and review each path.
; Do not replace a system-wide /etc/asterisk/asterisk.conf.
[directories]
astetcdir => /opt/lampp/htdocs/care/asterisk/local/etc
astmoddir => /usr/lib/asterisk/modules
astvarlibdir => /opt/lampp/htdocs/care/asterisk/local/var/lib
astdatadir => /opt/lampp/htdocs/care/asterisk/local/var/data
astkeydir => /opt/lampp/htdocs/care/asterisk/local/var/keys
astspooldir => /opt/lampp/htdocs/care/asterisk/local/var/spool
astrundir => /opt/lampp/htdocs/care/asterisk/local/var/run
astlogdir => /opt/lampp/htdocs/care/asterisk/local/var/log
astagidir => /opt/lampp/htdocs/care/asterisk/agi

[options]
verbose = 3
debug = 0
documentation_language = en_US
; The instance runs in foreground only when started with the -f command option.
