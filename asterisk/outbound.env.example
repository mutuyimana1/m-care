# Install as a root-owned private environment file. Never commit actual values.
# The same AMI host/user/secret must be available to Apache PHP and the event
# listener. Store the PJSIP trunk credential in a separate Asterisk-readable file.
MCARE_AMI_HOST=127.0.0.1
MCARE_AMI_PORT=5038
MCARE_AMI_USERNAME=mcare_outbound
MCARE_AMI_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
MCARE_OUTBOUND_PJSIP_ENDPOINT=mcare-mtn
MCARE_OUTBOUND_CALLER_ID=REPLACE_WITH_PROVIDER_AUTHORIZED_CALLER_ID
MCARE_OUTBOUND_NUMBER_FORMAT=REPLACE_WITH_PROVIDER_FORMAT
MCARE_OUTBOUND_NUMBER_PREFIX=
MCARE_OUTBOUND_RING_TIMEOUT_MS=45000
MCARE_OUTBOUND_MAX_CONCURRENT=2
MCARE_CALLING_HOUR_START=8
MCARE_CALLING_HOUR_END=18
MCARE_REMINDER_CALLS_ENABLED=0

# Add the existing care_db connection settings for the event listener if its
# service environment differs from Apache. Do not put database credentials here
# unless this file is root-owned and readable only by the required service users.
# MCARE_DB_HOST=127.0.0.1
# MCARE_DB_PORT=3306
# MCARE_DB_USER=...
# MCARE_DB_PASSWORD=...
# MCARE_DB_DATABASE=care_db
